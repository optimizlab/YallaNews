      "id": 29,
      "idAttr": "",
      "imageCount": 0,
      "isGarbage": false,
      "linkCount": 0,
      "linkDensity": 0.0,
      "parent": 17,
      "role": "",
      "tag": "p",
      "text": "بدلاً من إرسال آلاف العقد البرمجية المعقدة إلى الذكاء الاصطناعي، يتم ضغط الصفحة إلى عشرات العقد الجوهرية فقط، وهو ما يقلل استهلاك الذاكرة والمعالج بنسبة تتجاوز 85% مقارنة بالحلول البرمجية السابقة.",
      "textDensity": 358.0,
      "textLength": 358,
      "type": "PARAGRAPH"
    },
    {
      "children": [],
      "className": "pullquote",
      "contentScore": 0.0,
