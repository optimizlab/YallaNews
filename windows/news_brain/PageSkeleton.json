      "linkDensity": 0.0,
      "parent": 17,
      "role": "",
      "tag": "h2",
      "text": "مزايا التحليل الهيكلي وتخفيف استهلاك الذاكرة",
      "textDensity": 83.0,
      "textLength": 83,
      "type": "HEADING"
    },
    {
      "children": [],
      "className": "paragraph",
      "contentScore": 0.0,
